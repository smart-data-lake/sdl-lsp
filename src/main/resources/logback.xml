<configuration>

    <!-- Both can be set as system property or environment variable -->
    <property name="LOG_DIR" value="${SDL_LSP_LOG_DIR:-${user.home}/.sdl-lsp/logs}"/>
    <property name="LOG_LEVEL" value="${SDL_LSP_LOG_LEVEL:-INFO}"/>

    <!-- Appender to write logs to a file -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/sdl-lsp.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${LOG_DIR}/sdl-lsp.%i.log</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>10</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>10MB</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <pattern>%date{dd-MM-yyyy HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="LSP_CLIENT" class="io.smartdatalake.logging.ClientLogger">
        <pattern>%date{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </appender>

    <!-- Root logger settings: the level can also be changed with logLevel in .sdlb/lsp-config.conf -->
    <root level="${LOG_LEVEL}">
        <appender-ref ref="FILE"/>
        <appender-ref ref="LSP_CLIENT"/>
    </root>

</configuration>
