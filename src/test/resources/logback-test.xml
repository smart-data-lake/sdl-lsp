<configuration>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/test-logs/sdl-lsp.log</file>
        <append>false</append>
        <encoder>
            <pattern>%date{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="FILE"/>
    </root>

</configuration>
